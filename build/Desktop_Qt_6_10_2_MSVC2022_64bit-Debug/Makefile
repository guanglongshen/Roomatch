..\..\Roomatch.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile ..\..\Roomatch.pro -spec win32-msvc "CONFIG+=debug" "CONFIG+=qml_debug"

qmake_all: sub-RoomatchClient-qmake_all sub-RoomatchCommon-qmake_all sub-RoomatchServer-qmake_all FORCE

make_first: sub-RoomatchClient-make_first sub-RoomatchCommon-make_first sub-RoomatchServer-make_first  FORCE
all: sub-RoomatchClient-all sub-RoomatchCommon-all sub-RoomatchServer-all  FORCE
clean: sub-RoomatchClient-clean sub-RoomatchCommon-clean sub-RoomatchServer-clean  FORCE
distclean: sub-RoomatchClient-distclean sub-RoomatchCommon-distclean sub-RoomatchServer-distclean  FORCE
	-$(DEL_FILE) Makefile
	-$(DEL_FILE) .qmake.stash
install_subtargets: sub-RoomatchClient-install_subtargets sub-RoomatchCommon-install_subtargets sub-RoomatchServer-install_subtargets FORCE
uninstall_subtargets: sub-RoomatchClient-uninstall_subtargets sub-RoomatchCommon-uninstall_subtargets sub-RoomatchServer-uninstall_subtargets FORCE

sub-RoomatchClient-debug:
	@if not exist RoomatchClient\ mkdir RoomatchClient\ & if not exist RoomatchClient\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd RoomatchClient\ && ( if not exist Makefile $(QMAKE) -o Makefile E:\QTP\Roomatch\RoomatchClient\RoomatchClient.pro -spec win32-msvc "CONFIG+=debug" "CONFIG+=qml_debug" ) && $(MAKE) -f Makefile debug
sub-RoomatchCommon-debug:
	@if not exist RoomatchCommon\ mkdir RoomatchCommon\ & if not exist RoomatchCommon\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd RoomatchCommon\ && ( if not exist Makefile $(QMAKE) -o Makefile E:\QTP\Roomatch\RoomatchCommon\RoomatchCommon.pro -spec win32-msvc "CONFIG+=debug" "CONFIG+=qml_debug" ) && $(MAKE) -f Makefile debug
sub-RoomatchServer-debug:
